{
  "name": "beat-saber-maker",
  "version": "1.0.0",
  "private": true,
  "description": "Make Beat Saber maps from a song (or a YouTube link) and a cover image, straight into ChroMapper.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently -n server,client -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js --open",
    "sync-model": "node scripts/sync-model.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.6"
  }
}
